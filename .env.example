# Copy this file to .env for running locally. Never commit .env.

# Which AI paints portraits: flux (your Modal service) or gemini
IMAGE_PROVIDER=flux

# FLUX on Modal (see SETUP.md)
FLUX_ENDPOINT_URL=
FLUX_API_TOKEN=

# Optional Gemini backup, used automatically if FLUX fails
GEMINI_API_KEY=
IMAGE_FALLBACK=gemini

# Optional
PORT=3000
# ALLOWED_ORIGIN=https://keepsakephotos.onrender.com
# RATE_LIMIT_PER_HOUR=15
# TRUST_PROXY=true
# FLUX_TIMEOUT_MS=240000
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
