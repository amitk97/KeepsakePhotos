# Copy this file to .env and fill in your key. Never commit .env.

# Required: your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
PORT=3000
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Only accept portrait requests from your own site, e.g. https://keepsake.example.com
# ALLOWED_ORIGIN=
# Max portraits per guest per hour
# RATE_LIMIT_PER_HOUR=15
# Set to true when running behind a host or proxy (Render, Railway, Fly, nginx) so rate limits use the guest's real IP
# TRUST_PROXY=true
