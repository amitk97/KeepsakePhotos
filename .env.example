# Copy this file to .env for running locally. Never commit .env.

# Engines tried in order. When one is out of free allowance or fails, the next takes over.
# If all are unavailable, the guest's phone paints a free watercolour itself.
IMAGE_PROVIDERS=cloudflare,flux

# 1. Cloudflare Workers AI: free daily allowance, no card (see SETUP.md)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 2. FLUX Kontext on Modal: free $30/month credit (see SETUP.md)
FLUX_ENDPOINT_URL=
FLUX_API_TOKEN=
# Optional Real-ESRGAN upscaler (same Modal app, same token)
# UPSCALE_ENDPOINT_URL=

# Optional paid backup (about 5p a portrait): add ",gemini" to IMAGE_PROVIDERS
# GEMINI_API_KEY=

# Admin page at /admin (off unless set)
# ADMIN_PASSWORD=

# Google Drive uploads of finished keepsakes: off until all four are set (SETUP.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# Limits
# STUDIO_OPEN=true            # false = on-phone watercolour only
# DAILY_PORTRAIT_CAP=600      # AI portraits per day across all guests
# MAX_CONCURRENT=4            # painted at once; others wait in line
# MAX_WAITING=30              # most in line; beyond that, the on-phone watercolour
# RATE_LIMIT_PER_HOUR=15      # per phone
# RATE_LIMIT_PER_IP_HOUR=400  # per internet address (venue Wi-Fi shares one)
# CLOUDFLARE_DAILY_NEURONS=9500

# PORT=3000
# ALLOWED_ORIGIN=https://keepsakephotos.onrender.com
# TRUST_PROXY=true            # on Render/Railway/Fly: uses the address the host's proxy adds
